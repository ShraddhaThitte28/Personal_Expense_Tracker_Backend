# ===========================================================================
# Personal Expense Tracker - Environment Configuration Template
# ===========================================================================
# Copy this file to .env and fill in your actual values.
# DO NOT commit the .env file containing real secrets to version control.

# Database Configuration (Option A: Component-based, default for local PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=expense_tracker

# Database Configuration (Option B: Unified connection URL, standard on Render/Railway)
# If provided, DATABASE_URL takes precedence over the individual parameters above.
# Example: postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=

# JWT Authentication Secret Key (Generate a strong random string)
# Example: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed CORS Origins (comma-separated list for production domains)
# Example: https://your-expense-tracker.vercel.app,https://your-custom-domain.com
# Local development origins (localhost:5173, 127.0.0.1:5173) are always allowed.
ALLOWED_ORIGINS=

